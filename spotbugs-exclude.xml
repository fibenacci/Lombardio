<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/filter/3.0.0/src/main/resources/filter.xsd">

    <!-- Ignore informatory Spring Endpoint annotations from FindSecBugs. 
         This is just a marker that a method is exposed as an API, not a bug. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- Ignore MapStruct generated implementation classes which often trigger false positive warnings -->
    <Match>
        <Class name="~.*MapperImpl"/>
        <Or>
            <Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/>
            <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        </Or>
    </Match>

    <!-- Ignore False Positive EI_EXPOSE_REP2 for immutable Records or validated constructor fields.
         Lombardio uses Java 21 Records for Configuration/Properties which are inherently immutable. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~.*Properties"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="~.*Seeder"/>
            <Class name="~.*Adapter"/>
        </Or>
    </Match>

    <!-- Ignore False Positive UUF_UNUSED_FIELD / URF_UNREAD_FIELD in Spring Beans.
         SpotBugs sometimes fails to detect field usage in Lambda expressions or Spring-managed methods. -->
    <Match>
        <Or>
            <Bug pattern="UUF_UNUSED_FIELD"/>
            <Bug pattern="URF_UNREAD_FIELD"/>
        </Or>
        <Or>
            <Class name="~.*Controller"/>
            <Class name="~.*Adapter"/>
            <Class name="~.*Service"/>
        </Or>
    </Match>

    <!-- CRLF Log Injection is often a false positive for internal debugging logs -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Or>
            <Class name="~.*Seeder"/>
            <Class name="~.*Configuration"/>
        </Or>
    </Match>

</FindBugsFilter>
