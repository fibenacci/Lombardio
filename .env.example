# Local compose development uses a single Postgres role (`lombardio`) for all services.
# Keep the service-specific DB password variables aligned with `POSTGRES_PASSWORD`
# when running services outside docker compose.
COMPOSE_PROFILES=ops,auction,obs,aux
COMPOSE_BUILD_TARGET=runtime
POSTGRES_PASSWORD=change-me-postgres
IDENTITY_ACCESS_DB_PASSWORD=change-me-postgres
PLATFORM_DB_PASSWORD=change-me-postgres
LOAN_ORIGINATION_DB_PASSWORD=change-me-postgres
CUSTOMER_DB_PASSWORD=change-me-postgres
PAWN_TICKET_DB_PASSWORD=change-me-postgres
AUCTION_DB_PASSWORD=change-me-postgres
ONLINE_AUCTION_DB_PASSWORD=change-me-postgres
KYC_DB_PASSWORD=change-me-postgres
AML_DB_PASSWORD=change-me-postgres
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Requested-With
APP_CORS_EXPOSED_HEADERS=Content-Disposition,Location
APP_CORS_MAX_AGE_SECONDS=3600
CENTRIFUGO_API_KEY=change-me-centrifugo-api-key
CENTRIFUGO_HMAC_SECRET=change-me-centrifugo-hmac-secret
IDENTITY_SECURITY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
GF_SECURITY_ADMIN_USER=change-me-admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password
PLATFORM_OUTBOX_ACCESS_TOKEN=change-me-platform-outbox-token
RABBITMQ_USERNAME=change-me-rabbit-user
RABBITMQ_PASSWORD=change-me-rabbit-password
REDIS_HOST=redis
REDIS_PORT=6379
CUSTOMER_INTERNAL_SERVICE_TOKEN=change-me-customer-internal-token
CUSTOMER_PORTAL_PUBLIC_BASE_URL=http://localhost:5173/portal
INTEGRATION_EMAIL_DELIVERY_MODE=log
INTEGRATION_SMTP_ADDRESS=smtp.example.com:587
INTEGRATION_SMTP_USERNAME=
INTEGRATION_SMTP_PASSWORD=
INTEGRATION_SMTP_FROM_ADDRESS=no-reply@example.com
INTEGRATION_SMTP_FROM_NAME=Lombardio
INTEGRATION_RABBITMQ_EXCHANGE=lombardio.domain
INTEGRATION_WEBHOOK_DESTINATIONS=[]
DEMO_DATA_ENABLED=true
DEMO_DATA_SCALE=medium
IDENTITY_ACCESS_DEMO_DATA_SCALE=
PLATFORM_DEMO_DATA_SCALE=
LOAN_ORIGINATION_DEMO_DATA_SCALE=
CUSTOMER_DEMO_DATA_SCALE=
PAWN_TICKET_DEMO_DATA_SCALE=
AUCTION_DEMO_DATA_SCALE=
ONLINE_AUCTION_DEMO_DATA_SCALE=
KYC_DEMO_DATA_SCALE=
AML_DEMO_DATA_SCALE=
JAVA_CORE_TOOL_OPTIONS=
JAVA_DEFAULT_TOOL_OPTIONS=
JAVA_LIGHT_TOOL_OPTIONS=
INTEGRATION_GOMAXPROCS=
INTEGRATION_GOMEMLIMIT=
