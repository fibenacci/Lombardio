{
  "name": "@lombardio/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "api:generate": "openapi-typescript ./api-spec/platform-openapi.yaml -o ./src/shared/kernel/http/api-types.ts",
    "depcruise:customers": "dependency-cruiser -c dependency-cruiser.customers.mjs src/modules/customers",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@primeuix/themes": "~2.0.3",
    "js-cookie": "^3.0.5",
    "keycloak-js": "~26.2.3",
    "pinia": "~3.0.4",
    "primeicons": "~7.0.0",
    "primevue": "~4.5.4",
    "vue": "~3.5.13",
    "vue-router": "~4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "~5.2.1",
    "@vue/test-utils": "~2.4.6",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "~26.1.0",
    "openapi-typescript": "^7.13.0",
    "sass": "~1.89.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "~6.2.0",
    "vitest": "~3.2.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "brace-expansion": "2.0.3"
  }
}
