{
  "name": "@lombardio/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "api:generate": "npm run api:generate:platform && npm run api:generate:auction && npm run api:generate:identity && npm run api:generate:loan && npm run api:generate:online-auction && npm run api:generate:pawn-ticket && npm run api:generate:reporting",
    "api:generate:platform": "openapi-typescript ./src/shared/infrastructure/api/specs/platform-openapi.yaml --enum -o ./src/shared/infrastructure/api/types/platform.ts",
    "api:generate:auction": "openapi-typescript ./src/modules/auctions/infrastructure/api/specs/auction-openapi.yaml --enum -o ./src/modules/auctions/infrastructure/api/types/auction.ts",
    "api:generate:identity": "openapi-typescript ./src/modules/customers/infrastructure/api/specs/identity-intelligence-openapi.yaml --enum -o ./src/modules/customers/infrastructure/api/types/identity.ts",
    "api:generate:loan": "openapi-typescript ./src/modules/loans/infrastructure/api/specs/loan-origination-openapi.yaml --enum -o ./src/modules/loans/infrastructure/api/types/loan.ts",
    "api:generate:online-auction": "openapi-typescript ./src/modules/online-auctions/infrastructure/api/specs/online-auction-openapi.yaml --enum -o ./src/modules/online-auctions/infrastructure/api/types/online-auction.ts",
    "api:generate:pawn-ticket": "openapi-typescript ./src/modules/pawn-tickets/infrastructure/api/specs/pawn-ticket-openapi.yaml --enum -o ./src/modules/pawn-tickets/infrastructure/api/types/pawn-ticket.ts",
    "api:generate:reporting": "openapi-typescript ./src/modules/tenant-dashboard/infrastructure/api/specs/reporting-openapi.yaml --enum -o ./src/modules/tenant-dashboard/infrastructure/api/types/reporting.ts",
    "depcruise:customers": "dependency-cruiser -c dependency-cruiser.customers.mjs src/modules/customers",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@primeuix/themes": "~2.0.3",
    "js-cookie": "^3.0.8",
    "keycloak-js": "~26.2.4",
    "pinia": "~3.0.4",
    "primeicons": "~7.0.0",
    "primevue": "~4.5.5",
    "vue": "~3.5.35",
    "vue-router": "~5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "~6.0.7",
    "@vue/test-utils": "~2.4.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "~29.1.1",
    "openapi-typescript": "^7.13.0",
    "sass": "~1.100.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "~8.0.16",
    "vitest": "~4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "brace-expansion": "2.0.3"
  }
}
